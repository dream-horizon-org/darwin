    <darwin.listener.artifactId>darwinlistener-spark-3.5.0-scala-2.12.12</darwin.listener.artifactId>
  </properties>

  <!-- Different profiles based on spark version -->
  <profiles>
    <profile>
      <id>spark-3.5.0</id>
      <activation>
