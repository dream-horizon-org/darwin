<!--
  =============================================================================
  NOTE: This pom.xml is maintained for VERSION TRACKING and DOCUMENTATION only.
  
  Jars are NOT downloaded via Maven during build. Instead, pre-packaged jars
  are stored in the jar-resources/ folder and copied during the build process.
  
  To add new jars:
  1. Add the jar file to jar-resources/spark-<version>/
  2. Update this pom.xml with the dependency info for documentation
  
  Supported Spark versions:
  - spark-3.5.0 (default)
  =============================================================================
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
